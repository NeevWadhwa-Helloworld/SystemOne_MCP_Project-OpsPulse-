# Optional. Leave blank to use deterministic local routing and summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.0-flash
CORS_ORIGINS=http://localhost:3000
OPSPULSE_DB_PATH=./opspulse.db
BIND_HOST=127.0.0.1
PORT=8000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_MASTER_KEY=replace-with-a-new-fernet-key
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
MONITOR_ALERT_COOLDOWN_SECONDS=300
